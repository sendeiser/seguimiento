{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Notyx Design System - Glassmorphism",
  "description": "Glassmorphism design system for Notyx Education",
  
  "primitive": {
    "color": {
      "brand": {
        "50": { "$value": "262 100% 96%", "$type": "color" },
        "100": { "$value": "262 90% 90%", "$type": "color" },
        "200": { "$value": "262 80% 80%", "$type": "color" },
        "300": { "$value": "262 70% 68%", "$type": "color" },
        "400": { "$value": "262 60% 55%", "$type": "color" },
        "500": { "$value": "262 83% 60%", "$type": "color" },
        "600": { "$value": "262 70% 50%", "$type": "color" },
        "700": { "$value": "262 60% 40%", "$type": "color" },
        "800": { "$value": "262 50% 28%", "$type": "color" },
        "900": { "$value": "262 40% 15%", "$type": "color" }
      },
      
      "accent": {
        "cyan": { "$value": "185 85% 60%", "$type": "color" },
        "pink": { "$value": "330 90% 65%", "$type": "color" },
        "lime": { "$value": "140 70% 55%", "$type": "color" },
        "orange": { "$value": "25 95% 60%", "$type": "color" },
        "violet": { "$value": "270 70% 65%", "$type": "color" }
      },
      
      "neutral": {
        "50": { "$value": "220 40% 98%", "$type": "color" },
        "100": { "$value": "220 30% 96%", "$type": "color" },
        "200": { "$value": "220 20% 92%", "$type": "color" },
        "300": { "$value": "220 15% 80%", "$type": "color" },
        "400": { "$value": "220 10% 65%", "$type": "color" },
        "500": { "$value": "220 8% 50%", "$type": "color" },
        "600": { "$value": "220 10% 35%", "$type": "color" },
        "700": { "$value": "220 15% 20%", "$type": "color" },
        "800": { "$value": "220 20% 12%", "$type": "color" },
        "900": { "$value": "220 25% 6%", "$type": "color" }
      },
      
      "status": {
        "success": { "$value": "140 70% 45%", "$type": "color" },
        "warning": { "$value": "35 90% 55%", "$type": "color" },
        "error": { "$value": "0 85% 60%", "$type": "color" },
        "info": { "$value": "195 90% 55%", "$type": "color" }
      }
    },
    
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" }
    },
    
    "radius": {
      "sm": { "$value": "0.5rem", "$type": "dimension" },
      "md": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.5rem", "$type": "dimension" },
      "xl": { "$value": "2rem", "$type": "dimension" },
      "2xl": { "$value": "3rem", "$type": "dimension" },
      "3xl": { "$value": "4rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    
    "shadow": {
      "glass-sm": { "$value": "0 4px 24px -4px rgb(0 0 0 / 0.08)", "$type": "shadow" },
      "glass-md": { "$value": "0 8px 32px -8px rgb(0 0 0 / 0.12)", "$type": "shadow" },
      "glass-lg": { "$value": "0 16px 48px -12px rgb(0 0 0 / 0.15)", "$type": "shadow" },
      "glow": { "$value": "0 0 20px var(--color-primary)", "$type": "shadow" },
      "glow-lg": { "$value": "0 0 40px var(--color-primary)", "$type": "shadow" }
    },
    
    "transition": {
      "fast": { "$value": "150ms ease", "$type": "duration" },
      "normal": { "$value": "300ms ease", "$type": "duration" },
      "slow": { "$value": "500ms ease", "$type": "duration" }
    },
    
    "font": {
      "heading": { "$value": "'Outfit', sans-serif", "$type": "fontFamily" },
      "body": { "$value": "'DM Sans', sans-serif", "$type": "fontFamily" }
    },
    
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" },
      "5xl": { "$value": "3rem", "$type": "dimension" }
    }
  },
  
  "semantic": {
    "color": {
      "bg-primary": { "$value": "220 40% 98%", "$type": "color" },
      "bg-secondary": { "$value": "220 25% 96%", "$type": "color" },
      "text-primary": { "$value": "220 10% 12%", "$type": "color" },
      "text-secondary": { "$value": "220 8% 35%", "$type": "color" },
      "text-muted": { "$value": "220 10% 55%", "$type": "color" },
      "primary": { "$value": "262 83% 60%", "$type": "color" },
      "accent": { "$value": "185 85% 60%", "$type": "color" }
    },
    
    "glass": {
      "bg": { "$value": "255 255 255 / 0.15", "$type": "color" },
      "bg-light": { "$value": "255 255 255 / 0.08", "$type": "color" },
      "border": { "$value": "255 255 255 / 0.2", "$type": "color" },
      "blur": { "$value": "20px", "$type": "dimension" }
    }
  },
  
  "dark": {
    "semantic": {
      "color": {
        "bg-primary": { "$value": "220 25% 6%", "$type": "color" },
        "bg-secondary": { "$value": "220 20% 10%", "$type": "color" },
        "text-primary": { "$value": "220 20% 95%", "$type": "color" },
        "text-secondary": { "$value": "220 10% 70%", "$type": "color" },
        "text-muted": { "$value": "220 8% 50%", "$type": "color" },
        "primary": { "$value": "270 70% 70%", "$type": "color" },
        "accent": { "$value": "185 85% 65%", "$type": "color" }
      },
      "glass": {
        "bg": { "$value": "0 0 0 / 0.3", "$type": "color" },
        "bg-light": { "$value": "255 255 255 / 0.03", "$type": "color" },
        "border": { "$value": "255 255 255 / 0.08", "$type": "color" },
        "blur": { "$value": "20px", "$type": "dimension" }
      }
    }
  }
}